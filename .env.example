# ---------------------------------------------------------------
# ReproHub 环境变量（复制为 .env 后修改；缺省值均可直接运行）
# ---------------------------------------------------------------

# ---- LLM 提供商 -------------------------------------------------
# 可选: deepseek | qwen | zhipu | moonshot | openai | ollama | mock
# 具体 base_url / 默认模型见 config/site.yaml -> llm.providers
LLM_PROVIDER=deepseek

# DeepSeek（首选）。留空时：若 LLM_ALLOW_MOCK_FALLBACK=true 则进入「模拟模式」，
# 所有评分/解读/日报总述都是规则生成的占位内容，并在界面、API、CLI 中明确标注，
# 绝不伪报为真实模型调用。设为 false 则缺 key 直接报错退出。
DEEPSEEK_API_KEY=
LLM_ALLOW_MOCK_FALLBACK=true

# 其他可替换提供商（按需填写其一并把 LLM_PROVIDER 改过去）
QWEN_API_KEY=
ZHIPU_API_KEY=
MOONSHOT_API_KEY=
OPENAI_API_KEY=
# 自定义 OpenAI 兼容端点（LLM_PROVIDER=custom 时生效）
CUSTOM_LLM_BASE_URL=
CUSTOM_LLM_API_KEY=
CUSTOM_LLM_MODEL=

# ---- 数据源 -----------------------------------------------------
# NCBI E-utilities：无 key 时限 3 req/s；有 key 10 req/s。email 为 NCBI 礼貌要求
NCBI_API_KEY=
NCBI_EMAIL=you@example.org
# 微信公众号等需通过 RSSHub 转 RSS（可自建），留空则禁用依赖它的源
RSSHUB_BASE=

# ---- 推送 -------------------------------------------------------
# 各渠道地址/密钥在 config/push.yaml 里以 ${VAR} 形式引用
SERVERCHAN_SENDKEY=
BARK_URL=
NTFY_URL=
FEISHU_WEBHOOK=
WECOM_WEBHOOK=
DINGTALK_WEBHOOK=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
GENERIC_WEBHOOK_URL=

SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_TO=

# ---- 站点 -------------------------------------------------------
HOST=127.0.0.1
PORT=8008
# 后台 /admin 与写接口口令；留空则 /admin 仅允许本机访问且无口令
ADMIN_PASSWORD=
# POST /api/v1/ingest 推送入库的令牌；留空则该接口关闭
INGEST_TOKEN=
# 数据目录（默认 ./data）
REPROHUB_DATA_DIR=
